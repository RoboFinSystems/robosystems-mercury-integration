# RoboSystems API — https://api.robosystems.ai for the managed cloud,
# http://localhost:8000 for a local development stack.
ROBOSYSTEMS_API_URL=https://api.robosystems.ai

# API key for the graph you integrate with (X-API-Key header).
ROBOSYSTEMS_API_KEY=

# The graph this integration writes to (kg...).
ROBOSYSTEMS_GRAPH_ID=

# The source stamped on every event this integration emits. Registered as
# an external connection on first run.
INTEGRATION_SOURCE_NAME=mercury

# Mercury personal API token — Read Only is enough (Settings → API tokens).
# Never a read-write token: those require an IP allowlist and this
# integration never writes to Mercury.
MERCURY_API_KEY=
MERCURY_API_URL=https://api.mercury.com/api/v1

# Earliest transaction date to pull (YYYY-MM-DD). Re-runs are idempotent,
# so a wide window costs nothing but time.
MERCURY_SINCE=2025-01-01
